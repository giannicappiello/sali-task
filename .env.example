# Supabase principale (sali-task)
VITE_SUPABASE_URL=https://TUO-PROGETTO-PRINCIPALE.supabase.co
VITE_SUPABASE_ANON_KEY=CHIAVE_ANON_PRINCIPALE

# Serve solo per costruire gli URL pubblici degli allegati del progetto report-giornate.
# NON inserire mai la service_role nel frontend.
VITE_GIORNATE_SUPABASE_URL=https://TUO-PROGETTO-REPORT-GIORNATE.supabase.co

# Sprint 3 - creazione ordini Mexal
# Variabili server Vercel, NON usare il prefisso VITE_ e non inserirle nel frontend.
SUPABASE_URL=https://TUO-PROGETTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHIAVE_SERVICE_ROLE_SOLO_VERCEL

# CRM Digital Connection Manager - esclusivamente server-side Vercel.
# Generare una chiave casuale di 32 byte codificata base64; non riutilizzare altre chiavi.
CRM_CONNECTION_SECRET_KEY=CHIAVE_BASE64_32_BYTE_SOLO_VERCEL
CRM_DIGITAL_OAUTH_CALLBACK_URL=https://workspace.progre.it/api/crm/digital-connections/oauth/callback
CRON_SECRET=SEGRETO_CRON_SOLO_VERCEL

MEXAL_BASE_URL=https://server-mexal:porta
MEXAL_USERNAME=utente_webapi
MEXAL_PASSWORD=password_webapi
MEXAL_AZIENDA=GRE
MEXAL_ANNO=2026
MEXAL_MAGAZZINO=5
MEXAL_ORDER_ENDPOINT=/documenti/ordini-clienti
MEXAL_OCM_SERIE=M
MEXAL_OCX_SERIE=X

# Worker email ordini - configurare come Supabase Edge Function secrets.
SMTP_HOST=HOST_SMTP_ARUBA
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=gestioneordini@progre.it
SMTP_PASSWORD=PASSWORD_CASELLA_SMTP
ORDER_EMAIL_FROM=gestioneordini@progre.it
ORDER_EMAIL_NAME=Gestione Ordini Progre
WORKER_SECRET=SEGRETO_INTERNO_CONDIVISO_CON_IL_VAULT

# Assistente AI - su Vercel usa automaticamente VERCEL_OIDC_TOKEN.
# AI_GATEWAY_API_KEY serve soltanto per esecuzioni locali o server esterni.
AI_GATEWAY_API_KEY=CHIAVE_VERCEL_AI_GATEWAY_OPZIONALE
AI_MODEL=openai/gpt-5.6-luna

# Il connettore di pianificazione resta disabilitato finché ProgreMES non espone
# gli endpoint context/apply concordati. Non impostare true prima del collaudo.
PROGREMES_AI_PLANNING_ENABLED=false
PROGREMES_AI_CONTEXT_PATH=/api/workspace/ai/planning/context
PROGREMES_AI_APPLY_PATH=/api/workspace/ai/planning/apply

# Connessione ProgreMES condivisa da catalogo, SSO, AI e API read-only.
# Variabili esclusivamente server-side Vercel: non usare prefissi VITE_.
PROGREMES_URL=https://mes.example.invalid
PROGREMES_INTEGRATION_SECRET=INSERIRE_SECRET_CONDIVISO_SOLO_IN_VERCEL
# Timeout opzionale della sola API read-only, compreso tra 1000 e 30000 ms.
PROGREMES_API_TIMEOUT_MS=10000

# Fase 1C.0 - tutte le funzioni mutanti sono OFF per default.
# L'identificazione OCT resta configurabile finché cod_modulo=T non è verificato
# nel payload Mexal reale; non usare M/X/I, riservati ai flussi outbound esistenti.
MEXAL_OCT_IMPORT_ENABLED=false
MEXAL_OCT_MODULE_CODE=
MEXAL_OCT_LIST_PATH=
PROGREMES_PRODUCTION_REQUESTS_ENABLED=false
PROGREMES_PRODUCTION_CALLBACKS_ENABLED=false
PROGREMES_PRODUCTION_CONFIRMATIONS_ENABLED=false

# Riusa esclusivamente PROGREMES_URL e PROGREMES_INTEGRATION_SECRET,
# già server-side e senza prefisso VITE_.
