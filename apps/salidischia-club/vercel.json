{
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!assets/|sw\\.js$|workbox-[^/]+\\.js$|manifest\\.webmanifest$|.*\\.(?:png|webp|svg)$).*)", "destination": "/index.html" }],
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }, { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }, { "key": "X-Frame-Options", "value": "DENY" }] }, { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }]
}
