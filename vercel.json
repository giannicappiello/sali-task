{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/cron/mexal-products.js": {
      "maxDuration": 300
    },
    "api/mexal/submit-order.js": {
      "maxDuration": 300
    },
    "api/mexal/automation.js": {
      "maxDuration": 300
    },
    "api/mexal/queue-worker.js": {
      "maxDuration": 300
    },
    "api/cron/mexal-dispatcher.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/mexal-dispatcher",
      "schedule": "0 22 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/company-documents/compose",
      "destination": "/api/mexal/automation?route=company-document-compose"
    },
    {
      "source": "/api/company-letterheads/mes/resolve",
      "destination": "/api/mexal/automation?route=company-letterheads-mes"
    },
    {
      "source": "/api/progremes-production/events",
      "destination": "/api/mexal/automation?route=progremes-production-events"
    },
    {
      "source": "/api/progremes/:resource",
      "destination": "/api/mexal/automation?route=progremes-readonly&resource=:resource"
    },
    {
      "source": "/api/ai/assistant",
      "destination": "/api/mexal/automation?route=ai"
    },
    {
      "source": "/api/ai/crm-brief",
      "destination": "/api/mexal/automation?route=crm-ai"
    },
    {
      "source": "/api/crm/digital-connections",
      "destination": "/api/mexal/automation?route=crm-digital"
    },
    {
      "source": "/api/crm/digital-connections/oauth/callback",
      "destination": "/api/mexal/automation?route=crm-digital&action=oauth_callback"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}
